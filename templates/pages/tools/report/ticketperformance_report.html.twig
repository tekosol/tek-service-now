<div class="card mt-4">
    <div class="card-header">
        <h3 class="card-title">{{ __('Performance Summary') }}</h3>
    </div>
    <div class="card-body">
        <div class="row row-cards">
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-primary text-white avatar">
                                    <i class="ti ti-ticket"></i>
                                </span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">
                                    {{ summary.total }} {{ __('Total Tickets') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-green text-white avatar">
                                    <i class="ti ti-check"></i>
                                </span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">
                                    {{ summary.solved }} {{ __('Solved') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-yellow text-white avatar">
                                    <i class="ti ti-clock"></i>
                                </span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">
                                    {{ summary.pending }} {{ __('Pending') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-sm-6 col-lg-3">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="bg-red text-white avatar">
                                    <i class="ti ti-alert-circle"></i>
                                </span>
                            </div>
                            <div class="col">
                                <div class="font-weight-medium">
                                    {{ summary.overdue }} {{ __('Overdue') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">{{ __('Detailed Tickets') }}</h3>
        <a href="{{ export_url }}" class="btn btn-secondary btn-sm">
            <i class="ti ti-download"></i> {{ __('Download CSV') }}
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped">
            <thead>
                <tr>
                    <th>{{ __('ID') }}</th>
                    <th>{{ __('Title') }}</th>
                    <th>{{ __('Requester') }}</th>
                    <th>{{ __('Assigned To') }}</th>
                    <th>{{ __('Status') }}</th>
                    <th>{{ __('Entity') }}</th>
                    <th>{{ __('Created Date') }}</th>
                    <th>{{ __('Updated Date') }}</th>
                    <th>{{ __('Resolved Date') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for ticket in tickets %}
                <tr>
                    <td>{{ ticket.id }}</td>
                    <td>{{ ticket.name }}</td>
                    <td>{{ ticket.requester_name }}</td>
                    <td>{{ ticket.assignee_name }}</td>
                    <td>{{ ticket.status_name }}</td>
                    <td>{{ ticket.entity_name }}</td>
                    <td>{{ ticket.date }}</td>
                    <td>{{ ticket.date_mod }}</td>
                    <td>{{ ticket.solvedate }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="9" class="text-center">{{ __('No data available') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
